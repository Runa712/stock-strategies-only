{
  "id": "resonance-filters",
  "name": "共振濾網",
  "description": "三項都要過才算共振：大盤方向與部位相同、個股在 20 日均線的同一側、進場價靠近當時的日內 VWAP。VWAP 距離預設 0.5% 以內，這是可調的濾網寬度，不是配對出來的最佳值。大盤漲跌與月線都要用進場當下已經知道的數字。",
  "source": "manual",
  "created_at": "2026-10-13T00:00:00Z",
  "updated_at": "2026-10-13T00:00:00Z",
  "params": {
    "eps_threshold": 0.0,
    "roe_threshold": 0.0,
    "fundamental_pass_required": false,
    "backtest_years": 3,
    "hold_days": 1,
    "min_tech_score_for_signal": 100,
    "target_return": 0.01,
    "stop_loss": 0.01,
    "weight_fundamental": 0.0,
    "weight_technical": 0.0,
    "weight_backtest": 1.0,
    "min_total_score_for_buy": 100,
    "min_tech_score_for_buy": 100,
    "use_ma_alignment": false,
    "use_bollinger_bounce": false,
    "use_kd_golden_cross": false,
    "use_macd_bullish": false,
    "use_volume_patterns": false,
    "market_filter_enabled": false,
    "market_filter_ma_period": 20
  },
  "setup": {
    "family": "short_term",
    "role": "filter",
    "data_requirement": "intraday",
    "side": "both",
    "signal": {"type": "resonance"},
    "exit": {"mode": "none"},
    "checks": [
      {
        "id": "index_same_direction",
        "description": "大盤從進場當下往前看的方向，與部位相同。做多要指數上漲，做空要指數下跌。"
      },
      {
        "id": "stock_ma20_same_direction",
        "ma_period": 20,
        "description": "個股在 20 日均線之上才做多，之下才做空。均線用進場前已完成的收盤計算。"
      },
      {
        "id": "entry_near_vwap",
        "max_distance": 0.005,
        "description": "進場價離當時日內 VWAP 不超過 0.5%。這是預設寬度，可以改。"
      }
    ]
  }
}
